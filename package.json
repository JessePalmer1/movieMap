{
  "name": "moviemap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",

    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:psql": "docker compose exec db psql -U moviemap -d moviemap",

    "data:films": "tsx scripts/01-fetch-wikidata.ts",
    "data:plots": "tsx scripts/02-fetch-plots.ts",
    "data:moods": "tsx scripts/03-score-moods.ts",
    "data:embed": "tsx scripts/04-embed.ts",
    "data:normalize": "tsx scripts/05-normalize.ts",
    "data:posters": "tsx scripts/06-fetch-posters.ts",
    "data:load-scores": "tsx scripts/load-mood-scores.ts",

    "calibrate": "tsx scripts/calibrate.ts",
    "eval": "tsx scripts/eval.ts",
    "smoke": "tsx scripts/smoke-session.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
