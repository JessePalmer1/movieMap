# Copy to .env.local and fill in.

# Postgres. Matches docker-compose.yml (port 5433 to avoid clashing with a
# local Postgres on the default 5432).
DATABASE_URL=postgres://moviemap:moviemap@localhost:5433/moviemap

# Required by scripts/03-score-moods.ts (offline mood scoring) and the
# session rerank. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Only needed for scripts/04-embed.ts, which fills the text-embedding
# column used for similarity and de-duplication. Nothing in the core
# recommendation path depends on it. https://voyageai.com/
VOYAGE_API_KEY=

# Optional. Posters only — never used as model input, per TMDB's API terms.
# Without it the UI falls back to typographic poster cards.
TMDB_API_KEY=
